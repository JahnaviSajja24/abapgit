@EndUserText.label: 'Access Control'
@MappingRole: true
define role Z9730_R_TRAVEL {
    grant 
        select
            on
                Z9730_R_TRAVEL
                    where
                        (AgencyId) = aspect pfcg_auth(/LRN/AGCY, 
                                  /LRN/AGCY,
                                  ACTVT = '03');
                        
}